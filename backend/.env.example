# Copy to backend/.env and edit. The file is git-ignored, so keys never reach the repository.

# Career visualization with FLUX.1 Kontext [dev] through Hugging Face Inference Providers.
# Use "none" to switch the feature off (the app then says it is not available yet), or "mock"
# to try the camera and upload flow without a model (it returns the photo unchanged).
IMAGE_PROVIDER=flux_kontext_dev

# Required for flux_kontext_dev: a Hugging Face access token (it starts with hf_) that is allowed
# to call Inference Providers. Create one at https://huggingface.co/settings/tokens
# A hosting provider's own key also works, but then name that provider in IMAGE_INFERENCE_PROVIDER.
IMAGE_API_KEY=

# Optional. Defaults to black-forest-labs/FLUX.1-Kontext-dev
IMAGE_MODEL=

# Optional. Which provider serves the model: auto (default), fal-ai, replicate or wavespeed.
IMAGE_INFERENCE_PROVIDER=auto

# Optional. Seconds to wait for a finished image before giving up. Default 120.
IMAGE_TIMEOUT_SECONDS=120
